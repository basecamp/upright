#!/usr/bin/env bash
set -eu

GEM_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "== Installing gems =="
cd "$GEM_ROOT"
bundle check || bundle install

echo ""
echo "== Installing Playwright browsers =="
bundle exec playwright install chromium

echo ""
cd "$GEM_ROOT/test/dummy"
exec bin/setup "$@"

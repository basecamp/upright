<% @page_title = @incident.title %>

<div class="incident-editor incident-editor--<%= @incident.past? ? "resolved" : (@incident.maintenance? ? "maintenance" : @incident.impact) %>">
  <%= link_to "← All incidents", incidents_path, class: "incident-editor__back" %>

  <%= render "form" %>

  <section class="incident-section">
    <h2 class="incident-section__title">Lifecycle</h2>
    <ol class="lifecycle">
      <% statuses = @incident.class::STATUSES %>
      <% current = statuses.index(@incident.status) %>
      <% statuses.each_with_index do |status, index| %>
        <li class="lifecycle__step <%= "lifecycle__step--done" if current && index < current %> <%= "lifecycle__step--current" if index == current %>"><%= status.humanize %></li>
      <% end %>
    </ol>
  </section>

  <section class="incident-section">
    <h2 class="incident-section__title">Post an update</h2>
    <%= form_with url: incident_updates_path(@incident), scope: :incident_update, class: "composer",
          data: { controller: "form", action: "keydown.meta+enter->form#submit keydown.ctrl+enter->form#submit" } do |f| %>
      <div class="field">
        <span class="field__label">Status</span>
        <div class="segmented segmented--status" role="radiogroup" aria-label="Status">
          <% @incident.class::STATUSES.each do |status| %>
            <%= f.radio_button :status, status, checked: status == @incident.status, id: "update_status_#{status}" %>
            <%= label_tag "update_status_#{status}", status.humanize %>
          <% end %>
        </div>
      </div>
      <div class="field">
        <%= f.label :body, "Message", class: "field__label" %>
        <%= suggestion_picker url: incident_suggestions_path(@incident, field: :body), fields: %w[ incident_update[status] ], autofill: true do %>
          <%= f.text_area :body, value: @incident.suggestions.messages(status: @incident.status).first&.text,
                class: "field__input", placeholder: "What changed.", data: suggestion_input_data %>
        <% end %>
        <span class="field__hint">Choosing a status fills in the message used most often for it. Type to search past messages.</span>
      </div>
      <div class="incident-form__actions">
        <%= f.submit "Post update", class: "btn" %>
      </div>
    <% end %>
  </section>

  <section class="incident-section">
    <h2 class="incident-section__title">Timeline</h2>
    <ol class="timeline">
      <% @incident.updates.each do |update| %>
        <li class="timeline__item"><%= render "upright/incidents/updates/update", incident: @incident, update: update %></li>
      <% end %>
    </ol>
  </section>

  <% unless @incident.maintenance? %>
    <section class="incident-section">
      <h2 class="incident-section__title">Post-incident report</h2>
      <%= form_with model: @incident, scope: :incident, url: incident_path(@incident), method: :patch, class: "composer" do |f| %>
        <div class="field">
          <%= f.label :report, "Report", class: "field__label" %>
          <span class="field__hint">Shown on the public incident page above the timeline once it’s saved. Leave it blank until it’s ready to publish.</span>
          <%= f.text_area :report, class: "field__input", rows: 10,
                placeholder: "What happened, what caused it, and what we’re changing so it doesn’t happen again." %>
        </div>
        <div class="incident-form__actions">
          <%= f.submit "Save report", class: "btn" %>
        </div>
      <% end %>
    </section>
  <% end %>

  <section class="incident-section">
    <%= button_to "Delete #{@incident.maintenance? ? "maintenance" : "incident"}",
          incident_path(@incident), method: :delete, class: "btn",
          form: { data: { turbo_confirm: "Delete this #{@incident.maintenance? ? "maintenance" : "incident"}?" } } %>
  </section>
</div>
